# --- базовые ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- PostgreSQL + pgvector ---
DATABASE_URL=postgresql+psycopg2://cr:cr@postgres:5432/contracts
DATABASE_ECHO=false

# --- объектное хранилище: memory | minio ---
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=contracts

# --- векторный индекс: memory | pgvector ---
VECTOR_BACKEND=pgvector

# --- поиск: memory | elasticsearch ---
SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=legal_knowledge

# --- эмбеддинги: hashing | hf ---
EMBEDDING_BACKEND=hashing
# EMBEDDING_BACKEND=hf
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- LLM: rule-based | hf ---
LLM_BACKEND=rule-based
# LLM_BACKEND=hf
LLM_MODEL=google/flan-t5-base

# --- шина событий: memory | kafka ---
BUS_BACKEND=kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=contract-events
KAFKA_CONSUMER_GROUP=contract-review-worker

# --- RAG ---
RAG_TOP_K=3
